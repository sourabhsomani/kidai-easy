# Play a tune. Turn your sound on!
set tune to ["C", "C", "G", "G", "A", "A", "G"]
for each n in tune:
  play note n for 0.4 seconds
end
play note "F" for 0.4 seconds
play note "F" for 0.4 seconds
play note "E" for 0.4 seconds
play note "E" for 0.4 seconds
play note "D" for 0.4 seconds
play note "D" for 0.4 seconds
play note "C" for 0.8 seconds
play sound "win"
