{
  "comments": { "lineComment": "#" },
  "brackets": [["[", "]"], ["(", ")"], ["{", "}"]],
  "autoClosingPairs": [
    { "open": "[", "close": "]" }, { "open": "(", "close": ")" }, { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [["[", "]"], ["(", ")"], ["{", "}"], ["\"", "\""]],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*[^#]*:\\s*(#.*)?$",
    "decreaseIndentPattern": "^\\s*(end|else)\\b"
  },
  "wordPattern": "[\\p{L}_][\\p{L}\\p{N}_]*|-?\\d+(\\.\\d+)?"
}
